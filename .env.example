# URL base do backend (/server). Em dev local, aponte para o IP da sua máquina na
# rede (não "localhost" — o emulador/dispositivo físico não enxerga o localhost do
# seu computador), ex: http://192.168.0.10:3333. Em produção, a URL do deploy na Vercel.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3333

# Auth (Supabase) — Project URL e anon/public key, em Settings > API no
# dashboard do seu projeto Supabase. A anon key é pública por design (só dá
# acesso à Auth API); o acesso aos dados continua todo via /server com a
# service role key.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
