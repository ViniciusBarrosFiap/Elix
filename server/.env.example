# Porta usada só em desenvolvimento local (`npm run dev`). A Vercel ignora isso em produção.
PORT=3333

# Supabase — projeto criado em https://supabase.com/dashboard
# Use a Service Role Key (NUNCA a anon key) — este server roda com privilégios totais
# e é ele quem garante o isolamento por usuário, não o Supabase Auth/RLS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Bucket do Supabase Storage usado para guardar os arquivos originais (best-effort).
# Crie um bucket PRIVADO com esse nome no dashboard do Supabase antes de rodar.
SUPABASE_STORAGE_BUCKET=materials

# Google Gemini — chave gerada em https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque-a-api-key-aqui
# IMPORTANTE: alguns projetos free-tier têm cota ZERO para "gemini-2.0-flash"
# especificamente (erro 429 RESOURCE_EXHAUSTED, limit: 0), enquanto outros modelos
# no mesmo projeto têm cota normal. Antes de rodar, confira suas cotas por modelo em
# https://ai.dev/rate-limit (ou Google AI Studio > Limite de taxa da API) e ajuste
# aqui para um modelo com cota disponível — "gemini-2.5-flash" costuma funcionar.
GEMINI_MODEL=gemini-2.5-flash

# Limite de caracteres de texto extraído enviados para o Gemini em uma única chamada
# (sem chunking multi-chamada nesta fase — ver plano/documentação).
MAX_INPUT_CHARS=80000

# Limite de tamanho de arquivo aceito no upload (MB).
MAX_UPLOAD_MB=15
