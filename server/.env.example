# Porta usada só em desenvolvimento local (`npm run dev`). A Vercel ignora isso em produção.
PORT=3333

# Supabase — projeto criado em https://supabase.com/dashboard
# Use a Service Role Key (NUNCA a anon key) — este server roda com privilégios totais
# e é ele quem garante o isolamento por usuário, não o Supabase Auth/RLS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Bucket do Supabase Storage usado para guardar os arquivos originais (best-effort).
# Crie um bucket PRIVADO com esse nome no dashboard do Supabase antes de rodar.
SUPABASE_STORAGE_BUCKET=materials

# OpenAI — chave gerada em https://platform.openai.com/api-keys
OPENAI_API_KEY=coloque-a-api-key-aqui
# O pipeline de geração faz 1 chamada de planejamento + 1 chamada em paralelo
# por subtema (até ~2-6 chamadas por material, mais se algum subtema precisar
# de retry) — confira que sua conta tem billing habilitado e cota (RPM/TPM)
# suficiente em https://platform.openai.com/settings/organization/limits.
# "gpt-5-nano" é o padrão: suporta Structured Outputs (response_format
# json_schema com strict:true) E o parâmetro reasoning_effort (ambos usados em
# generateStudyContent.ts). Modelos fora da família gpt-5/o-series (ex:
# gpt-4o-mini) NÃO aceitam reasoning_effort — a OpenAI rejeita a chamada com
# 400 "Unrecognized request argument supplied: reasoning_effort".
OPENAI_MODEL=gpt-5-nano

# Limite de caracteres de texto extraído enviados pra IA em uma única chamada
# (sem chunking multi-chamada nesta fase — ver plano/documentação).
MAX_INPUT_CHARS=80000

# Limite de tamanho de arquivo aceito no upload (MB).
MAX_UPLOAD_MB=15

# Integração com o Notion (OAuth 2.0) — opcional. Sem essas 3 variáveis, o
# server sobe normal e só as rotas /api/notion respondem 501.
#
# 1. Crie uma integração PÚBLICA em https://www.notion.so/my-integrations
#    (tipo "Public integration", com capability "Read content").
# 2. Copie o "OAuth client ID" e o "OAuth client secret" pra cá.
# 3. Em "Redirect URIs" da integração, cadastre a URL pública deste server
#    terminando em /api/notion/callback (ex: https://seu-deploy.vercel.app/api/notion/callback)
#    e cole a MESMA URL abaixo — precisam ser idênticas.
NOTION_CLIENT_ID=coloque-o-oauth-client-id-aqui
NOTION_CLIENT_SECRET=coloque-o-oauth-client-secret-aqui
NOTION_REDIRECT_URI=https://seu-deploy.vercel.app/api/notion/callback

# Deep link de volta pro app depois que o OAuth termina — precisa bater com
# o "scheme" do app.json do app (Expo). Não precisa mudar se o scheme
# continuar "elix".
APP_DEEP_LINK_URL=elix://notion-connected
